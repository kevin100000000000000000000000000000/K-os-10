#!/usr/bin/python3
import gi, os
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib

class Monitor(Gtk.Window):
    def __init__(self):
        super().__init__(title="KOS System Monitor")
        self.set_default_size(620, 430)
        css = Gtk.CssProvider()
        css.load_from_path("/usr/share/kos/kos.css")
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.set_margin_start(20); box.set_margin_end(20); box.set_margin_top(20)
        self.add(box)
        self.cpu = Gtk.ProgressBar(); self.memory = Gtk.ProgressBar()
        for label, bar in (("CPU usage", self.cpu), ("Memory usage", self.memory)):
            box.pack_start(Gtk.Label(label=label), False, False, 0)
            box.pack_start(bar, False, False, 0)
        self.details = Gtk.Label()
        box.pack_start(self.details, False, False, 0)
        GLib.timeout_add_seconds(2, self.refresh)
        self.refresh()

    def refresh(self):
        import psutil
        self.cpu.set_fraction(psutil.cpu_percent(interval=None) / 100)
        memory = psutil.virtual_memory()
        self.memory.set_fraction(memory.percent / 100)
        uptime = os.popen("uptime -p").read().strip()
        self.details.set_text(f"{uptime}\nRAM: {memory.used // 1048576} / {memory.total // 1048576} MiB")
        return True

if __name__ == "__main__":
    win = Monitor()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()
