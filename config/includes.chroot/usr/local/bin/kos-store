#!/usr/bin/python3
import gi, os, subprocess
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk

CATALOG = [
    ("firefox-esr", "Firefox ESR", "Secure web browser"),
    ("libreoffice", "LibreOffice", "Office productivity suite"),
    ("vlc", "VLC", "Audio and video player"),
    ("lutris", "Lutris", "Gaming library and Wine launcher"),
    ("steam-installer", "Steam", "Steam package installer"),
    ("wine", "Wine", "Windows compatibility layer"),
    ("winetricks", "Winetricks", "Windows runtime helper"),
    ("gimp", "GIMP", "Image editor"),
    ("inkscape", "Inkscape", "Vector graphics editor"),
]

def is_installed(package):
    result = subprocess.run(["dpkg-query", "-W", "-f=${Status}", package],
                            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    return result.stdout.strip() == "install ok installed"

class Store(Gtk.Window):
    def __init__(self):
        super().__init__(title="KOS Store")
        self.set_default_size(760, 560)
        self.set_position(Gtk.WindowPosition.CENTER)
        css = Gtk.CssProvider()
        css.load_from_path("/usr/share/kos/kos.css")
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.add(outer)
        header = Gtk.Label()
        header.set_markup('<span size="large" weight="bold">KOS Store</span>')
        header.set_margin_top(16); header.set_margin_bottom(12)
        outer.pack_start(header, False, False, 0)
        scrolled = Gtk.ScrolledWindow()
        scrolled.set_vexpand(True)
        outer.pack_start(scrolled, True, True, 0)
        listbox = Gtk.ListBox()
        scrolled.add(listbox)
        for package, name, description in CATALOG:
            row = Gtk.ListBoxRow()
            rowbox = Gtk.Box(spacing=12)
            rowbox.set_margin_top(10); rowbox.set_margin_bottom(10)
            rowbox.set_margin_start(12); rowbox.set_margin_end(12)
            text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            text.pack_start(Gtk.Label(label=name), False, False, 0)
            text.pack_start(Gtk.Label(label=description), False, False, 0)
            rowbox.pack_start(text, True, True, 0)
            installed = is_installed(package)
            button = Gtk.Button(label="Remove" if installed else "Install")
            button.connect("clicked", self.change_package, package, not installed)
            rowbox.pack_end(button, False, False, 0)
            row.add(rowbox)
            listbox.add(row)

    def change_package(self, _button, package, install):
        action = "install" if install else "remove"
        command = ["pkexec", "apt-get", "--yes", action, package]
        subprocess.Popen(command, start_new_session=True)

if __name__ == "__main__":
    win = Store()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()
