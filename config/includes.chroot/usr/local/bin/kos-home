#!/usr/bin/python3
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk

APPS = [
    ("Browser", "firefox-esr", "web-browser"),
    ("YouTube", "xdg-open https://youtube.com", "applications-multimedia"),
    ("AI", "kos-ai", "applications-science"),
    ("Files", "thunar", "system-file-manager"),
    ("Terminal", "xfce4-terminal", "utilities-terminal"),
    ("Store", "kos-store", "system-software-install"),
    ("Updates", "kos-update", "system-software-update"),
    ("Settings", "xfce4-settings-manager", "preferences-system"),
    ("Monitor", "kos-monitor", "utilities-system-monitor"),
]

class KOSHome(Gtk.Window):
    def __init__(self):
        super().__init__(title="KOS Home")
        self.set_default_size(780, 520)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.apply_theme()

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        box.set_margin_top(30); box.set_margin_bottom(30)
        box.set_margin_start(30); box.set_margin_end(30)
        self.add(box)

        title = Gtk.Label()
        title.set_markup('<span size="x-large" weight="bold">KOS Home</span>')
        box.pack_start(title, False, False, 0)

        grid = Gtk.Grid(row_spacing=18, column_spacing=18)
        grid.set_halign(Gtk.Align.CENTER)
        box.pack_start(grid, True, True, 0)
        for index, (name, command, icon) in enumerate(APPS):
            button = Gtk.Button()
            button.set_size_request(130, 100)
            content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            content.pack_start(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.DIALOG), True, True, 0)
            content.pack_start(Gtk.Label(label=name), False, False, 0)
            button.add(content)
            button.connect("clicked", self.launch, command)
            grid.attach(button, index % 3, index // 3, 1, 1)

    def apply_theme(self):
        css = Gtk.CssProvider()
        css.load_from_path("/usr/share/kos/kos.css")
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def launch(self, _button, command):
        import shlex, subprocess
        subprocess.Popen(shlex.split(command), start_new_session=True)

if __name__ == "__main__":
    KOSHome()
    Gtk.main()
