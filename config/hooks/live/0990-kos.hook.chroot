#!/bin/sh
set -eu

ln -sf /usr/share/zoneinfo/UTC /etc/localtime
update-alternatives --install /usr/share/applications/x-www-browser x-www-browser /usr/bin/firefox-esr 100 || true

install -d -m 0755 /etc/polkit-1/rules.d
cat > /etc/polkit-1/rules.d/49-kos-store.rules <<'EOF'
polkit.addRule(function(action, subject) {
    if ((action.id == "com.ubuntu.packagekit.package-install" ||
         action.id == "org.freedesktop.packagekit.package-install") &&
        subject.active && subject.local) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
EOF

cat > /etc/lightdm/lightdm.conf.d/50-kos.conf <<'EOF'
[Seat:*]
greeter-session=lightdm-gtk-greeter
greeter-hide-users=false
user-session=xfce
EOF

if ! id kos >/dev/null 2>&1; then
    useradd -m -G sudo,audio,video,plugdev,netdev,bluetooth -s /bin/bash kos
    passwd -d kos
fi

systemctl enable ufw.service 2>/dev/null || true
ufw default deny incoming 2>/dev/null || true
ufw default allow outgoing 2>/dev/null || true
ufw --force enable 2>/dev/null || true

update-desktop-database /usr/share/applications 2>/dev/null || true
gtk-update-icon-cache -f /usr/share/icons/hicolor 2>/dev/null || true

chmod 0755 /usr/local/bin/kos-home /usr/local/bin/kos-store /usr/local/bin/kos-update \
    /usr/local/bin/kos-monitor /usr/local/bin/kos-ai

cat > /etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-desktop" version="1.0">
  <property name="backdrop" type="empty">
    <property name="screen0" type="empty">
      <property name="monitor0" type="empty">
        <property name="workspace0" type="empty">
          <property name="last-image" type="string" value="/usr/share/backgrounds/kos/kos-liquid-glass.svg"/>
        </property>
      </property>
    </property>
  </property>
</channel>
EOF

install -d -m 0755 /etc/skel/Desktop
ln -sf /usr/share/applications/kos-installer.desktop /etc/skel/Desktop/Install-KOS.desktop
ln -sf /usr/share/applications/kos-home.desktop /etc/skel/Desktop/KOS-Home.desktop

cat > /etc/profile.d/kos-branding.sh <<'EOF'
export KOS_RELEASE="KOS 1.0"
export QT_QPA_PLATFORMTHEME=gtk3
EOF
